{
  "rules": {
    "bz-apps": {
      "whisky": {
        "directory": {
          ".read": "auth != null",
          ".indexOn": [
            "key"
          ],
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['uid','name','key'])",
            "uid": {
              ".validate": "newData.val() === auth.uid"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "key": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "requests": {
          "$toUid": {
            ".read": "auth != null && $toUid === auth.uid",
            "$fromUid": {
              ".write": "auth != null && ($fromUid === auth.uid || $toUid === auth.uid)",
              ".validate": "newData.hasChildren(['from','name','at'])",
              "from": {
                ".validate": "newData.val() === $fromUid"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "shares": {
          "$ownerUid": {
            ".read": "auth != null && $ownerUid === auth.uid",
            "$withUid": {
              ".write": "auth != null && $ownerUid === auth.uid",
              ".validate": "newData.hasChildren(['at'])",
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "sharedWith": {
          "$viewerUid": {
            ".read": "auth != null && $viewerUid === auth.uid",
            "$ownerUid": {
              ".write": "auth != null && $ownerUid === auth.uid",
              ".validate": "newData.hasChildren(['at'])",
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "shared": {
          ".read": "auth != null",
          "_comment_stamp": "Admin, like everything else under shared. stamp is what every client watches to decide the library has changed, so a plain signed-in account could write it in a loop and make every device re-download the whole catalogue. Only an admin can change anything it announces.",
          "stamp": {
            ".write": "auth != null && root.child('bz-apps/whisky/admins').child(auth.uid).exists()"
          },
          "catalog": {
            "products": {
              "$key": {
                ".write": "auth != null && (!data.exists() || root.child('bz-apps/whisky/admins').child(auth.uid).exists())",
                ".validate": "newData.hasChildren(['name','at']) || !newData.exists()"
              },
              ".indexOn": "at"
            },
            ".write": "auth != null && root.child('bz-apps/whisky/admins').child(auth.uid).exists()"
          },
          ".write": "auth != null && root.child('bz-apps/whisky/admins').child(auth.uid).exists()"
        },
        "view": {
          "$uid": {
            ".read": "auth != null && ($uid === auth.uid || root.child('bz-apps/whisky/shares').child($uid).child(auth.uid).exists())",
            ".write": "auth != null && $uid === auth.uid"
          }
        },
        "admins": {
          ".read": "auth != null",
          "$uid": {
            ".write": "false"
          }
        },
        "stats": {
          ".read": "auth != null && root.child('bz-apps/whisky/admins').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('bz-apps/whisky/admins').child(auth.uid).exists())",
            ".read": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['name','at','version'])"
          }
        },
        "contrib": {
          ".read": "auth != null && root.child('bz-apps/whisky/admins').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('bz-apps/whisky/admins').child(auth.uid).exists())",
            ".read": "auth != null && $uid === auth.uid"
          }
        },
        "upc": {
          ".read": "auth != null",
          "$key": {
            ".write": "auth != null && (!data.exists() || root.child('bz-apps/whisky/admins').child(auth.uid).exists())",
            ".validate": "$key.matches(/^[0-9]{12}$/) && newData.hasChildren(['name','at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "size": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$uid": {
          ".read": "auth != null && $uid === auth.uid",
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    }
  }
}